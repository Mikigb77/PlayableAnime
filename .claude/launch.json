{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "lucid.asgi:application", "--port", "8080"],
      "env": {"DEBUG": "1"},
      "port": 8080
    },
    {
      "name": "app-web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "app/build/web"],
      "port": 8090
    }
  ]
}
