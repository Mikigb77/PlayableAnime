#!/usr/bin/env bash
# A stand-in for the Neon CLI in the infra tests: `connection-string <branch> --project-id <id>
# [--pooled]` prints $FAKE_NEON_POOLED or $FAKE_NEON_DIRECT, and fails as a signed-out CLI does when
# they aren't set.
set -euo pipefail
[ "${1:-}" = connection-string ] || exit 2
printf 'neonctl %s\n' "$*" >>"${FAKE_STATE:?FAKE_STATE is not set}/neonctl.log"
case " $* " in
  *" --pooled "*) url="${FAKE_NEON_POOLED:-}" ;;
  *) url="${FAKE_NEON_DIRECT:-}" ;;
esac
if [ -z "$url" ]; then
  echo "ERROR: Authentication required (fake)" >&2
  exit 1
fi
printf '%s\n' "$url"
