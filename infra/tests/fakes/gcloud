#!/usr/bin/env bash
# A stand-in for gcloud in the infra tests. It logs every call to $FAKE_STATE/calls.log and keeps
# just enough state to show whether the scripts create each thing once and re-run cleanly.
set -euo pipefail

state="${FAKE_STATE:?FAKE_STATE is not set}"
mkdir -p "$state/res"
{
  printf 'gcloud'
  for arg in "$@"; do printf ' %q' "$arg"; done
  printf '\n'
} >>"$state/calls.log"

positional=()
format=''
display_name=''
for arg in "$@"; do
  case "$arg" in
    --format=*) format="${arg#--format=}" ;;
    --display-name=*) display_name="${arg#--display-name=}" ;;
    --env-vars-file=*) cp "${arg#--env-vars-file=}" "$state/last-env.yaml" ;;
    -*) ;;
    *) positional+=("$arg") ;;
  esac
done

verbs=" login create create-oidc describe update update-oidc undelete list add enable deploy execute update-traffic set-cleanup-policies add-iam-policy-binding remove-iam-policy-binding get-iam-policy get-value read cp cat ls rm "
group=''
verb=''
resource=''
for i in "${!positional[@]}"; do
  word="${positional[$i]}"
  if [[ "$verbs" == *" $word "* ]]; then
    verb="$word"
    resource="${positional[$((i + 1))]:-}"
    break
  fi
  group="${group:+$group }$word"
done
resource="${resource%%@*}"
resource="${resource#gs://}"
if [[ "$group" == "billing budgets" && "$verb" == create ]]; then
  resource="$display_name"
fi
if [[ "$group" == run && "$verb" == deploy ]]; then
  group="run services"
fi
key="$(printf '%s %s' "$group" "$resource" | tr ' /' '__')"
exists() { [[ -e "$state/res/$key" ]]; }

service_url="https://playable-anime-api-abc123xyz-ey.a.run.app"

case "$group/$verb" in
  # FAKE_SIGNED_OUT: no account until `auth login`. FAKE_WRONG_ACCOUNT: an account that can't see
  # the project until `auth login`.
  "config/get-value")
    if [[ -z "${FAKE_SIGNED_OUT:-}" || -e "$state/signed-in" ]]; then echo "miki@example.com"; fi
    ;;
  "auth/login") touch "$state/signed-in" ;;
  "config configurations/describe") [[ -n "${FAKE_HAS_CONFIGURATION:-}" ]] ;;
  "projects/describe")
    if [[ -n "${FAKE_WRONG_ACCOUNT:-}" && ! -e "$state/signed-in" ]]; then
      echo "ERROR: (fake) PERMISSION_DENIED: projects.get" >&2
      exit 1
    fi
    echo "528988811295"
    ;;
  "billing projects/describe") echo "billingAccounts/000000-AAAAAA-BBBBBB" ;;
  "billing budgets/list")
    if compgen -G "$state/res/billing_budgets_*" >/dev/null; then
      echo "billingAccounts/000000-AAAAAA-BBBBBB/budgets/budget-1"
    fi
    ;;
  "secrets versions/add")
    cat >"$state/secret-$resource"
    touch "$state/res/$key"
    ;;
  "secrets versions/list")
    [[ -z "${FAKE_FAIL_SECRET_LIST:-}" ]] || exit 1
    if exists; then echo 1; fi
    ;;
  "run services/deploy")
    [[ -z "${FAKE_FAIL_DEPLOY:-}" ]] || exit 1
    touch "$state/res/$key"
    echo $(($(cat "$state/deploys" 2>/dev/null || echo 0) + 1)) >"$state/deploys"
    ;;
  "run jobs/deploy") touch "$state/res/$key" ;;
  "run jobs/execute")
    if [[ " $* " == *" --args=manage.py,draw_premise_covers "* ]]; then
      [[ -z "${FAKE_FAIL_COVERS:-}" ]]
    elif [[ " $* " == *" --args=manage.py,check_models "* ]]; then
      [[ -z "${FAKE_FAIL_MODELS:-}" ]]
    else
      [[ -z "${FAKE_FAIL_MIGRATION:-}" ]]
    fi
    ;;
  "logging/read")
    [[ -z "${FAKE_FAIL_LOGS:-}" ]] || {
      echo "ERROR: (fake) PERMISSION_DENIED: logging.logEntries.list" >&2
      exit 1
    }
    printf '2026-11-04T07:35:00Z\tERROR\tfake-log-line Model call rejected\n'
    ;;
  # Who may call the service: $state/public exists while allUsers is an invoker.
  "run services/add-iam-policy-binding")
    [[ -z "${FAKE_FAIL_ACCESS:-}" ]] || exit 1
    if [[ " $* " == *" --member=allUsers "* ]]; then touch "$state/public"; fi
    ;;
  "run services/remove-iam-policy-binding")
    [[ -e "$state/public" ]] || {
      echo "ERROR: (fake) Policy binding not found" >&2
      exit 1
    }
    rm "$state/public"
    ;;
  "run services/get-iam-policy")
    exists || exit 1
    if [[ -e "$state/public" ]]; then
      echo '{"bindings": [{"members": ["allUsers"], "role": "roles/run.invoker"}], "etag": "x"}'
    else
      echo '{"etag": "x"}'
    fi
    ;;
  "run services/describe")
    exists || exit 1
    [[ "$format" == json ]] || exit 2
    revision="playable-anime-api-0000$(cat "$state/deploys" 2>/dev/null || echo 0)-abc"
    traffic="{\"revisionName\": \"$revision\", \"percent\": 100, \"latestRevision\": true}"
    if [[ -n "${FAKE_TRAFFIC_SPLIT:-}" ]]; then
      # A tagged preview listed first with no traffic, then a 30/70 split.
      traffic="{\"revisionName\": \"preview-rev\", \"tag\": \"preview\"},
        {\"revisionName\": \"minor-rev\", \"percent\": 30},
        {\"revisionName\": \"major-rev\", \"percent\": 70}"
    fi
    cat <<JSON
{
  "metadata": {"annotations": {"run.googleapis.com/urls":
    "[\"$service_url\",\"https://playable-anime-api-528988811295.europe-west3.run.app\"]"}},
  "status": {"url": "$service_url", "latestReadyRevisionName": "$revision",
    "traffic": [$traffic]}
}
JSON
    ;;
  # Objects in buckets are files under $state/gcs/<bucket>/<key>. FAKE_FAIL_UPLOAD: no write access.
  "storage/cp")
    [[ -z "${FAKE_FAIL_UPLOAD:-}" ]] || {
      echo "ERROR: (fake) HTTPError 403: storage.objects.create denied" >&2
      exit 1
    }
    object="$state/gcs/${positional[3]#gs://}"
    mkdir -p "$(dirname "$object")"
    cp "${positional[2]}" "$object"
    printf '%s %s\n' "${positional[3]}" \
      "${CLOUDSDK_STORAGE_PARALLEL_COMPOSITE_UPLOAD_ENABLED:-unset}" >>"$state/composite.log"
    ;;
  "storage/cat")
    object="$state/gcs/${positional[2]#gs://}"
    [[ -f "$object" ]] || {
      echo "ERROR: (fake) The following URLs matched no objects or files" >&2
      exit 1
    }
    cat "$object"
    ;;
  "storage/ls")
    folder="$state/gcs/${positional[2]#gs://}"
    found=''
    for object in "$folder"*; do
      if [[ -f "$object" ]]; then
        printf 'gs://%s\n' "${object#"$state/gcs/"}"
        found=1
      fi
    done
    [[ -n "$found" ]] || {
      echo "ERROR: (fake) One or more URLs matched no objects." >&2
      exit 1
    }
    ;;
  "storage/rm")
    for url in "${positional[@]:2}"; do rm "$state/gcs/${url#gs://}"; done
    ;;
  */create | */create-oidc)
    if exists; then
      echo "ERROR: (fake) $group $resource already exists" >&2
      exit 1
    fi
    touch "$state/res/$key"
    ;;
  */describe)
    exists || exit 1
    case "$format" in
      *state*) if [[ -n "${FAKE_DELETED:-}" ]]; then echo DELETED; else echo ACTIVE; fi ;;
      *deleted*) if [[ -n "${FAKE_DELETED:-}" ]]; then echo True; fi ;;
      *) echo "$resource" ;;
    esac
    ;;
  *) ;;
esac
