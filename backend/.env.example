# Copy to backend/.env for local runs. Never commit .env.

# Local development only: relaxes the secret key and serves the admin's assets from the apps.
DEBUG=1
# DJANGO_SECRET_KEY=   # required when DEBUG is off

# "fake" = offline canned narrator, "vertex" = Gemini on Vertex AI (needs ADC, see README).
LLM_PROVIDER=fake
GCP_PROJECT=playable-anime
VERTEX_LOCATION=global
# One model per node (B6). Defaults are in graph/llm/config.py; <NODE>_THINKING sets the
# thinking level (minimal, low, medium, high).
NARRATOR_MODEL=gemini-3.5-flash
# INTERPRET_MODEL=gemini-3.5-flash-lite
# CHECKER_MODEL=gemini-3.1-flash-lite
# TICK_MODEL=gemini-3.1-flash-lite
# SUMMARIZER_MODEL=gemini-3.1-flash-lite
# DRAFTER_MODEL=gemini-3.5-flash
# PICTURE_MODEL=gemini-3.1-flash-lite-image
# INTERPRET_THINKING=low

# Sign-in. Google sign-in needs the OAuth client ids from the playable-anime project (comma-separated);
# email and password sign-up works without them.
# GOOGLE_OAUTH_CLIENT_IDS=
OWNER_EMAILS=mikigb77@gmail.com
MIN_SIGNUP_AGE=13

# With DEBUG=1 and no DATABASE_URL, the local Docker Postgres from the README is used
# (postgresql://postgres:postgres@localhost:5432/lucid). With Neon, `neon checkout` (run in the repo
# root) writes DATABASE_URL and DATABASE_URL_UNPOOLED to ../.env.local. Values set here take
# precedence over that file, so leave these commented out when you use Neon.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lucid
